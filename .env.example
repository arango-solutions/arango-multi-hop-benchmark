# ArangoDB connection (manual / local-dev path)
#
# Leave these unset when running inside the Arango Managed Platform — the
# kube-arangodb sidecar will inject ARANGO_DEPLOYMENT_ENDPOINT + ARANGO_TOKEN
# (see below) and the app will auto-connect via JWT.
ARANGO_HOST=https://your-arango-host
ARANGO_DB=ingest_bench_db
ARANGO_USERNAME=root
ARANGO_PASSWORD=change-me

# Arango Managed Platform (AMP) auto-connect — populated by the platform
# at deploy time, set them by hand only when you want to exercise the AMP
# code path locally.
#
# ARANGO_DEPLOYMENT_ENDPOINT  — HTTPS endpoint of the deployment, e.g.
#                               https://deployment.default.svc:8529
# ARANGO_TOKEN                — PATH to a rotating JWT file (NOT the token
#                               value itself); the file is re-read on every
#                               connection so rotation is transparent.
# ARANGO_DEPLOYMENT_CA        — optional path to the deployment's CA PEM.
# ARANGO_DEPLOYMENT_NAME      — informational; surfaced in the status pill.
# AMP=true                    — force the AMP UI path even when the token
#                               file is not yet readable (handy for testing).
# ARANGO_DEPLOYMENT_ENDPOINT=https://deployment.default.svc:8529
# ARANGO_TOKEN=/var/run/secrets/arango/token/token
# ARANGO_DEPLOYMENT_CA=/etc/deployment-int/ca/ca.pem
# AMP=true

# Autograph project name. Every collection below defaults to
# '<project>_<suffix>' (and 'qa_pairs_<project>_v1' for the QA output), so
# setting this once names the whole set. Leave the per-collection overrides
# below unset to derive them from this value.
ARANGO_PROJECT_NAME=multihop_eval

# Collection names (override only if an individual collection differs from the
# '<project>_<suffix>' default derived from ARANGO_PROJECT_NAME).
# ARANGO_SIMILARITY_COLLECTION=multihop_eval_similarities
# ARANGO_RELATIONS_COLLECTION=multihop_eval_corpus_relations
# ARANGO_RAGS_COLLECTION=multihop_eval_rags
# ARANGO_SOURCES_COLLECTION=multihop_eval_sources
# ARANGO_DOMAINS_COLLECTION=multihop_eval_domains
# ARANGO_QA_COLLECTION=qa_pairs_multihop_eval_v1

# LLM (OpenAI-compatible Chat Completions)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4.1
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_S=180
LLM_RETRIES=3
LLM_BACKOFF_BASE=2

# LangFuse (optional — only required if you enable the human-annotation panel
# on the RAG Eval tab; install with `uv sync --extra dev --extra langfuse`).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Logging
LOG_LEVEL=INFO

# FastAPI / BYOC routing (optional)
# The React SPA + API are served on 0.0.0.0:8000 at the container root. The
# platform proxy prefix is handled in the browser (Vite base "./" + apiBase()),
# so no base-path var is required. ROOT_PATH only affects FastAPI's OpenAPI/docs
# URL generation behind a reverse proxy. Example: /_service/uds/_global/multihop-eval
ROOT_PATH=
