# Builder image for the Arango BYOC zipfile artifact.
#
# The Arango platform deploys a service by extracting a tarball on top of the
# base image at /project and running `python <entrypoint>` — it does NOT
# install dependencies at runtime. So the tarball must already contain a
# complete /project/the_venv. That venv MUST be built inside the Linux base
# image (never copied from a developer's macOS .venv), which is what this
# Dockerfile does. `scripts/package-arango-manual.sh` builds this image and
# extracts /project into project.tar.gz.
#
# Stage 1 builds the React/Vite SPA. Stage 2 lays out /project and builds
# /project/the_venv via uv (the base image has uv + a 3.13 venv, but no system
# python3).

# ---------------------------------------------------------------------------
# Stage 1: build the SPA into ui/dist
# ---------------------------------------------------------------------------
FROM node:20-slim AS ui-build
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: lay out /project and build the self-contained venv
# ---------------------------------------------------------------------------
FROM arangodb/py13base:latest

USER root

# Source + build hook live under /project (flat layout: main.py at /project root).
COPY main.py requirements.txt pyproject.toml /project/
COPY src /project/src
COPY scripts/prepareproject.sh scripts/sync-requirements.sh /project/scripts/
COPY --from=ui-build /ui/dist /project/ui/dist

# entrypoint: first token is the Python file the base image's entrypoint.sh runs
# (it does `cd /project && python $(cat entrypoint)`).
RUN printf 'main.py\n' > /project/entrypoint \
    && chmod +x /project/scripts/*.sh \
    && chown -R user:user /project

USER user
WORKDIR /project

# Build a COMPLETE /project/the_venv with all deps (uv, python 3.13).
RUN /project/scripts/prepareproject.sh

# Drop caches/bytecode so they don't bloat the extracted tarball.
RUN find /project -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true
